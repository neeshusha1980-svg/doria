# ==============================================================================
# Doria Independent Platform — Environment Configuration Template
# Copy to .env and populate all secrets via your hosting provider's secret
# manager before starting the stack. Never commit real secrets to source control.
# ==============================================================================

# --- Core Runtime ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Public URLs (update to your custom domain in production, e.g. https://doria.example.com)
PUBLIC_APP_URL=http://localhost:8080
BETTER_AUTH_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# --- PostgreSQL 17 Database ---
POSTGRES_DB=doria
POSTGRES_USER=doria
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://doria:CHANGE_ME_STRONG_POSTGRES_PASSWORD@localhost:5432/doria

# --- Authentication (Better Auth) ---
# Generate a strong random secret (>= 32 chars): openssl rand -base64 48
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_CHARS_RANDOM_SECRET

# Optional Google OAuth credentials (leave blank for email/password only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Administrator Allowlist ---
# Comma-separated list of verified administrator email addresses.
# Leave empty to disable administrator access until configured.
ADMIN_EMAILS=

# --- S3-Compatible Object Storage (MinIO locally; AWS S3 / Cloudflare R2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=doria-media
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_KEY
S3_FORCE_PATH_STYLE=true

# --- Neo AI Server-Side Provider Adapter ---
# Supported providers: openai | anthropic | gemini | openai-compatible
NEO_AI_PROVIDER=openai
NEO_AI_API_KEY=CHANGE_ME_SERVER_SIDE_AI_PROVIDER_KEY
NEO_AI_MODEL=gpt-4o-mini
NEO_AI_BASE_URL=
NEO_AI_TIMEOUT_MS=45000

# --- Optional Redis Pub/Sub for Multi-Instance WebSockets ---
REDIS_URL=

# --- Frontend Build-Time Public Configuration (Never place secrets here) ---
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_APP_PUBLIC_URL=http://localhost:8080
VITE_PRIVACY_CONTACT_EMAIL=privacy@example.com
VITE_GOOGLE_AUTH_ENABLED=false
